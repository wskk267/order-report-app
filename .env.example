# Local HTTP listener. Keep the API bound to localhost when Caddy/frpc is used.
ORDER_REPORT_HOST=127.0.0.1
ORDER_REPORT_PORT=3011

# SQLite file. This path is ignored by Git.
ORDER_REPORT_DB_PATH=./runtime/order-report.sqlite3

# Optional fixed token. If blank, the server creates runtime/sync-token with mode 0600.
# The token is required by the Android app and must never be committed.
ORDER_REPORT_SYNC_TOKEN=

# Optional token file path.
ORDER_REPORT_TOKEN_FILE=./runtime/sync-token
