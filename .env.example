# Local HTTP listener. Keep the API bound to localhost when Caddy/frpc is used.
ORDER_REPORT_HOST=127.0.0.1
ORDER_REPORT_PORT=3011

# Optional runtime directory. The database and generated token both use this
# directory unless their individual paths are explicitly overridden. Prefer an
# absolute path outside the source repository for a custom production location.
# ORDER_REPORT_RUNTIME_DIR=/var/lib/order-report

# Optional SQLite override. Leave commented to follow ORDER_REPORT_RUNTIME_DIR.
# ORDER_REPORT_DB_PATH=/var/lib/order-report/order-report.sqlite3

# Optional fixed token. If blank, the server creates sync-token in the selected
# runtime directory with mode 0600.
# The token is required by the Android app and must never be committed.
ORDER_REPORT_SYNC_TOKEN=

# Optional token-file override. Leave commented to follow ORDER_REPORT_RUNTIME_DIR.
# ORDER_REPORT_TOKEN_FILE=/var/lib/order-report/sync-token
